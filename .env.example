# Backend API
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Stellar / Soroban
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Authentication
NEXT_PUBLIC_JWT_EXPIRY=1d

# WebSocket
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Feature flags (all default to off; accepts true/false/1/0/on/off)
NEXT_PUBLIC_FF_EXPERIMENTAL_LIVE_TRACKING=false
NEXT_PUBLIC_FF_EXPERIMENTAL_BULK_SHIPMENTS=false
